{
  "name": "loose-ends-monorepo",
  "private": true,
  "type": "module",
  "description": "Graph-powered liveness checks for AI-written code.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "bundle:action": "npm run build && node packages/action/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
