{
  "name": "loose-ends",
  "version": "1.2.0",
  "description": "Graph-powered liveness checks for AI-written code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loose-ends": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "dead-code",
    "reachability",
    "static-analysis",
    "typescript",
    "ai",
    "code-review"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@loose-ends/core": "1.2.0",
    "commander": "^15.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sid732/loose-ends.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
